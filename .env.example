# Copy to .env to customize. Exported variables take precedence.
# Relative paths are resolved from the directory containing app.py.
# Leave empty until a trusted local checkpoint is available.
WD_MODEL_PATH=
WD_CONFIDENCE_THRESHOLD=0.50
WD_INPUT_DIR=inputs
WD_OUTPUT_DIR=outputs
# Relative database and evidence paths are resolved under WD_OUTPUT_DIR.
WD_DATABASE_PATH=incidents.sqlite3
WD_EVIDENCE_DIR=evidence
WD_ALERT_CONFIRMATION_FRAMES=3
WD_ALERT_COOLDOWN_SECONDS=5
# MiB. The dashboard enforces this within Streamlit’s server limit.
WD_MAX_UPLOAD_MB=200
# Confirmation counts positive processed observations within this window.
WD_ALERT_WINDOW=5
WD_ALERT_MAX_GAP_SECONDS=3
WD_ALERT_RESET_MISSES=3
# Default maximum number of processed observations per dashboard run.
WD_MAX_VIDEO_FRAMES=300
